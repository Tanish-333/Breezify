rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True if the caller has been invited onto apps/{appId} (see
    // apps/{appId}/collaborators/{uid} below, managed only through
    // app/api/apps/[appId]/collaborators — an app's owner can invite an
    // existing Breezify user, who then gets read access to that one app,
    // and — if their role allows it, see isAppEditor below — write access
    // too, using their own credits and plan, not the owner's).
    function isAppCollaborator(database, appId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/apps/$(appId)/collaborators/$(request.auth.uid));
    }

    // True for the owner, or a collaborator whose role isn't "viewer" (a
    // role missing entirely — every collaborator doc written before roles
    // existed — is treated as "editor", the only behavior that existed
    // before this distinction, so nobody's access silently narrows). A
    // viewer keeps isAppCollaborator's read access below but fails this,
    // which is what actually makes "viewer" read-only: every direct
    // client write to apps/{appId} (rename, manual code edit, revert to a
    // version) is gated on this, on top of app/api/generate,
    // app/api/deploy, duplicate, and GitHub push/sync each checking the
    // same thing server-side via lib/app-collaborators.ts's hasEditAccess.
    function isAppEditor(database, appId) {
      return isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
        || (
          isSignedIn()
          && get(/databases/$(database)/documents/apps/$(appId)/collaborators/$(request.auth.uid)).data.role != "viewer"
        );
    }

    // The credit costs a generation can ever charge (see lib/types.ts
    // MODEL_INFO). Every write that touches credits or logs a transaction
    // must match one of these exactly, this is what stands in for a
    // trusted backend now that all writes, including the ones from our own
    // API routes, are authenticated as the calling user rather than an
    // admin service account.
    // 0 covers generations run with the user's own provider API key, where
    // nothing is charged because they pay their provider directly.
    function isValidCost(n) {
      return n == 0 || n == 0.5 || n == 1.0 || n == 1.5 || n == 2.0;
    }

    // users/{uid}: profile + credit balance.
    match /users/{userId} {
      allow read: if isOwner(userId);
      // The signup bonus itself is only ever granted by
      // app/api/claim-signup (Admin SDK, bypasses these rules entirely),
      // which also enforces a per-IP monthly cap that a security rule has
      // no way to see or check. A direct client-side create is still
      // allowed as a defensive fallback (e.g. that endpoint being briefly
      // unreachable), but capped at 0 credits so it can never itself be
      // used to claim or re-claim the bonus.
      allow create: if isOwner(userId)
        && request.resource.data.plan == "free"
        && request.resource.data.credits == 0;
      // Plan can't be self-assigned, and credits can only ever move by
      // staying the same or dropping by exactly one valid generation cost.
      // That's what makes it safe for /api/generate to spend credit using
      // the user's own ID token instead of an admin key: the rule is the
      // enforcement, not the caller's trustworthiness. (The Stripe webhook
      // sets plan/credits on a real payment via the Admin SDK, which
      // bypasses these rules entirely, not through this path.)
      allow update: if isOwner(userId)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.credits <= resource.data.credits
        && (
          request.resource.data.credits == resource.data.credits
          || isValidCost(resource.data.credits - request.resource.data.credits)
        )
        && request.resource.data.credits >= 0;
      allow delete: if isOwner(userId);
    }

    // signups/{uid}: an immutable, one-time marker proving this uid has
    // already claimed its free signup bonus. Written once, alongside the
    // very first users/{uid} doc, and never deletable, so it survives even
    // if users/{uid} is later deleted (directly, or via account deletion) —
    // that's what stops the delete-your-own-profile-and-recreate-it trick
    // from re-granting the bonus.
    match /signups/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(["claimedAt"]);
      allow update, delete: if false;
    }

    // signupIps/{ip_month}: per-IP, per-month counter of how many accounts
    // have claimed the signup bonus from that address (see
    // app/api/claim-signup). Admin SDK only — a security rule has no way to
    // read the caller's real IP, so this can't be enforced here; it exists
    // purely so the client can never read or tamper with its own count.
    match /signupIps/{ipKey} {
      allow read, write: if false;
    }

    // apps/{appId}: generated apps.
    match /apps/{appId} {
      allow read: if isOwner(resource.data.userId) || isAppCollaborator(database, appId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if (
        isAppEditor(database, appId)
        && request.resource.data.userId == resource.data.userId
      ) || (
        // Public visit-counter increments for deployed-app analytics
        // (see app/api/track): no auth required, but this is the ONLY
        // thing an anonymous caller may ever do here, an exact +1 to
        // "visits" and nothing else, so it can't be used to touch
        // anything else on the document.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visits"])
        && request.resource.data.visits == resource.data.visits + 1
      ) || (
        // Ownership transfer (see lib/use-apps.ts's transferOwnership) —
        // only the CURRENT owner, and only to someone already invited as a
        // collaborator on this app, and userId is the only thing this
        // particular write may touch (the matching collaborators/{uid}
        // create/delete pair that actually swaps the two people's roles is
        // a separate write in the same client-side batch, checked by the
        // rules on that subcollection below).
        isOwner(resource.data.userId)
        && request.resource.data.userId != resource.data.userId
        && exists(/databases/$(database)/documents/apps/$(appId)/collaborators/$(request.resource.data.userId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userId"])
      );
      allow delete: if isOwner(resource.data.userId);

      match /events/{eventId} {
        allow read: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId);
        allow write: if false;
      }

      // analytics/{day}: daily visit rollups (total/country/referrer/device/
      // path breakdowns) for the Analytics page. Only ever written by
      // lib/traffic-guard.ts's recordView() via the Admin SDK — an anonymous
      // visitor's beacon has no ID token to write with, and the breakdowns
      // themselves (country, referrer) aren't safe to let a client compute
      // and submit unverified anyway. Same owner-only read as events/{eventId}.
      match /analytics/{day} {
        allow read: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId);
        allow create, update: if false;
        // Only real client-side write these ever need: lib/deploy-actions.ts's
        // deleteApp() cleaning these up alongside secrets/versions/collaborators
        // when the owner deletes the whole app (Firestore doesn't cascade-delete
        // subcollections on its own).
        allow delete: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId);
      }

      // versions/{turnId}: a file snapshot taken after each turn, so a turn
      // can be reverted to later. One per turn, immutable once written.
      // Ownership lives directly on the document (userId, stamped by every
      // writer) rather than being checked via get() on the parent apps/{appId}
      // doc: a version is routinely created in the same request as its
      // parent app doc, and within one Firestore commit, get() calls in
      // rules only ever see the state from BEFORE that commit applies — so
      // checking the parent that way could reject a version whose own
      // parent was created moments earlier, depending on how the writes
      // were batched. Checking a field on the write itself has no such
      // ordering dependency.
      // Read is also open to collaborators (turn history is shared work,
      // not private to whoever happened to create each snapshot) — but that
      // check is safe to route through get()/exists() on the parent here,
      // unlike the CREATE rule just below: a read isn't part of the same
      // multi-write commit that might have just created the parent, so
      // there's no staleness window the way there was for ownership checks
      // on create.
      match /versions/{turnId} {
        allow read: if isOwner(resource.data.userId) || isAppCollaborator(database, appId);
        allow create: if isOwner(request.resource.data.userId);
        // Content itself stays immutable (no update, ever — that's what
        // makes a version trustworthy to revert to). Delete is owner-only,
        // needed for deleteApp() (lib/deploy-actions.ts) to clean these up when
        // the whole app goes: it batch-deletes every version alongside the
        // parent apps/{appId} doc, and Firestore batches are all-or-nothing
        // — with this at `if false`, that batch was rejected outright for
        // any app that had ever had a single turn (i.e. virtually every
        // app), failing the entire delete with no explanation beyond
        // "couldn't delete this app."
        allow update: if false;
        allow delete: if isOwner(resource.data.userId);
      }

      // secrets/{secretId}: key/value pairs the app owner configures for
      // their generated app (e.g. an API key it calls out with). Owner-only
      // in both directions, including for collaborators — deliberately not
      // shared, so inviting someone to work on an app never hands them its
      // API keys. Same reasoning as versions/{turnId} above: ownership is a
      // field on the document itself, not a cross-document get().
      match /secrets/{secretId} {
        allow read, delete: if isOwner(resource.data.userId);
        // Also checks the parent app's real owner, not just that the writer
        // stamped their own uid — secrets are never created in the same
        // commit as their parent app doc (always a separate later action
        // from the Secrets panel), so this get() carries none of the
        // same-commit staleness risk versions/{turnId} above was written
        // around, and it's what actually keeps a non-owner (a collaborator
        // included) from planting a secret under someone else's app.
        allow create: if isOwner(request.resource.data.userId)
          && isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId);
        allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      }

      // collaborators/{uid}: who besides the owner can work on this app, and
      // at what role ("editor" full access, "viewer" read-only — see
      // isAppEditor above). Only the owner can invite (create), change a
      // role, or remove someone else; a collaborator may remove themselves
      // (leave) but never anyone else, and can never add themselves.
      match /collaborators/{collabUid} {
        allow read: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
          || isOwner(collabUid)
          || isAppCollaborator(database, appId);
        // uid must mirror the doc's own path segment: useCollaboratingApps()
        // finds a user's shared apps with a collectionGroup query filtered
        // on this field (documentId() equality doesn't work across a
        // collection group), so a mismatched value here would silently hide
        // — or misdirect — that invite from the "shared with me" list. Also
        // used to write the outgoing owner's own new collaborator doc as
        // part of an ownership transfer (lib/use-apps.ts's
        // transferOwnership) — get() here resolves against this commit's
        // PRE-write state, so the caller is still "the owner" for this
        // check even though the same batch's apps/{appId} write is what's
        // about to hand ownership to someone else.
        allow create: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
          && request.resource.data.uid == collabUid
          && request.resource.data.role in ["editor", "viewer"];
        allow delete: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
          || isOwner(collabUid);
        // Role changes only — everything else about an existing invite
        // (uid, email, who added them, when) is immutable.
        allow update: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
          && request.resource.data.role in ["editor", "viewer"];
      }

      // presence/{uid}: a live "who's currently viewing this app" heartbeat
      // (see lib/use-presence.ts) — each viewer writes only their own doc,
      // refreshed on an interval and deleted on unmount, so onSnapshot
      // listeners elsewhere can show real-time collaborator presence.
      // Anyone who can already see this app (owner or collaborator) can see
      // who else is looking at it; nobody can write another uid's doc.
      match /presence/{presenceUid} {
        allow read: if isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
          || isAppCollaborator(database, appId);
        allow write: if isOwner(presenceUid)
          && (
            isOwner(get(/databases/$(database)/documents/apps/$(appId)).data.userId)
            || isAppCollaborator(database, appId)
          );
      }
    }

    // domainOrders/{sessionId}: pending/completed domain-purchase records,
    // keyed by the Stripe Checkout Session ID that pays for them. Created
    // by the buyer's own request (app/api/domains/purchase) right before
    // they're sent to Stripe Checkout, always "pending" at that point; only
    // the Stripe webhook (via the Admin SDK, which bypasses these rules
    // entirely) ever moves one to "purchasing"/"completed"/"failed", so a
    // client-side update is never legitimate.
    match /domainOrders/{orderId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == "pending";
      allow update, delete: if false;
    }

    // app_data/{appId}/{collection}/{docId}: the generic per-app data store
    // generated apps can use for real persistence (see app/api/app-data),
    // instead of localStorage-only. Any signed-in visitor (including
    // anonymous Firebase auth, which generated apps use) may create a
    // record they own; only that visitor may edit or delete it later.
    // Reads are public because a generated app's own UI is usually the only
    // thing querying this, and it commonly needs to show everyone's data
    // (e.g. a shared list), not just the current visitor's.
    match /app_data/{appId}/{collection}/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // transactions/{txId}: billing/credit history. Immutable once written.
    match /transactions/{txId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.type == "generation"
        && isValidCost(request.resource.data.creditsUsed);
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // feedback/{feedbackId}: user feedback and support submissions.
    // Signed-in users can submit feedback only about their own uid.
    match /feedback/{feedbackId} {
      allow read: if false; // Admin/support access only
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // metrics/{metricId}: Web Vitals and performance metrics.
    // Can be written by anyone (public collection), read-only for admin analysis.
    match /metrics/{metricId} {
      allow read: if false; // Admin/analytics only
      allow create: if request.resource.data.timestamp != null;
      allow update, delete: if false;
    }

    // client-errors/{errorId}: client-side error logs.
    // Can be written by anyone, read-only for debugging.
    match /client-errors/{errorId} {
      allow read: if false; // Admin/debugging only
      allow create: if request.resource.data.timestamp != null;
      allow update, delete: if false;
    }
  }
}
