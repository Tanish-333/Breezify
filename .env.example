# Firebase (client config, not secret, safe to expose). These already have
# working defaults for Breezify's own Firebase project baked into
# lib/firebase-public-config.ts, so you only need to set these if you're
# pointing this app at your own Firebase project instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anthropic (Claude). This one is a real secret, required.
ANTHROPIC_API_KEY=

# Google Gemini. Optional: without it the Gemini models show as
# unavailable and the Anthropic ones still work.
GEMINI_API_KEY=

# Groq (fast Llama inference). Optional: without it the Groq models show as
# unavailable and every other provider still works. Create a key at
# console.groq.com/keys.
GROQ_API_KEY=

# Vercel (lets Breezify deploy generated apps to a live *.vercel.app URL
# with no CLI or git repo involved). Create a token at
# vercel.com/account/tokens. Without it, the Deploy button shows a
# "not configured" error instead of deploying.
VERCEL_TOKEN=
# Only needed if the token above belongs to a team account rather than a
# personal one.
VERCEL_TEAM_ID=
# Set this to breezify.app once it's bought and added as a domain on the
# Vercel project/team above (Project Settings -> Domains -> Add, then verify
# it per Vercel's DNS instructions). Every deploy then aliases to
# {slug}.breezify.app instead of a *.vercel.app URL automatically — no code
# change needed beyond this one env var. Leave blank until then; deploys
# fall back to the default *.vercel.app URL until it's set.
DEPLOY_DOMAIN=
# For free-tier apps ONLY (see middleware.ts and app/apps/[subdomain]):
# once DEPLOY_DOMAIN is set, add BOTH `breezify.app` AND the wildcard
# `*.breezify.app` as domains on THIS project (the main Breezify app) in
# Vercel — not just the apex. The wildcard is what makes every free-tier
# subdomain resolve to this same project by default; a paid app's own
# real Vercel-project alias (tryCustomAlias in lib/vercel-deploy.ts) still
# takes priority for its own specific subdomain once deployed, so this
# doesn't conflict with paid hosting.

# Stripe (real billing: Plus/Pro/Max checkout, renewals, and the billing
# portal). Create a secret key at dashboard.stripe.com/apikeys, a recurring
# monthly Price for each paid plan under Product catalog, and a webhook
# endpoint at <your-app-url>/api/stripe/webhook subscribed to at least
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid,
# customer.subscription.updated, and customer.subscription.deleted
# (its signing secret is STRIPE_WEBHOOK_SECRET). Without these, the billing
# page's Upgrade buttons show a clear "not configured" error.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
# Only needed if you switch to Stripe Elements/embedded checkout later; the
# current flow redirects to Stripe's own hosted Checkout page instead.
STRIPE_PUBLIC_KEY=

# Firebase Admin service account — see lib/firebase-admin.ts for the exact,
# narrow list of places this is used (the Stripe webhook, resolving a
# collaborator invite's email to a uid, the free-tier traffic-cap/expiry
# check in lib/traffic-guard.ts, and looking a free-tier app up by its
# subdomain in lib/tenant-app.ts). All of them have no signed-in user's own
# ID token to authenticate as, so they can't go through the normal per-user
# Firestore rules path every other write in this app uses. Generate one at
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key, then paste the whole JSON file's contents here (or
# base64-encode it first if your env var UI mangles newlines).
#
# REQUIRED for free-tier deploys, not just recommended: without this,
# app/apps/[subdomain] can't look apps up at all and every free-tier
# subdomain shows a 503, and separately, MONTHLY_PAGE_VIEW_LIMIT /
# DEPLOY_EXPIRY_DAYS silently stop being enforced everywhere else. Billing
# and paid-plan Vercel deploys still work fine without it.
FIREBASE_SERVICE_ACCOUNT=

# Google sign-in for visitors of GENERATED apps (see app/api/oauth/google/
# start + .../callback, and the "Sign in with Google" recipe in
# lib/generation/prompt.ts). One OAuth client, owned by Breezify, shared
# across every generated app — not the same thing as Breezify's own
# Google login (that's a plain Firebase Auth provider, toggled in Firebase
# Console, no env vars needed).
#
# Create at console.cloud.google.com (same project as Firebase) -> APIs &
# Services -> Credentials -> Create Credentials -> OAuth client ID -> Web
# application. Authorized redirect URIs: <NEXT_PUBLIC_APP_URL>/api/oauth/
# google/callback for every domain this deploys to (vercel.app during
# testing, the real domain once it's live — both can be listed at once).
#
# Optional: without these, /api/oauth/google/start returns a plain 503 and
# generated apps' Google sign-in shows that as an inline error — nothing
# else on the platform depends on this.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Resend (transactional email: collaborator-invite notifications and new-
# feedback alerts — see lib/email.ts). Optional: without RESEND_API_KEY,
# sending is skipped entirely and both features keep working otherwise
# (the invite still goes through, there's just no email about it). Create a
# key at resend.com/api-keys.
RESEND_API_KEY=
# The From address invite/feedback emails send from. Defaults to Resend's
# own onboarding@resend.dev, which works with zero setup but is rate-limited
# and best for testing only. Once breezify.app is bought, verify it as a
# domain in Resend (resend.com/domains -> Add Domain -> add the TXT/CNAME/MX
# records it gives you) and set this to something like
# "Breezify <noreply@breezify.app>" for real deliverability.
RESEND_FROM_EMAIL=
# Where new in-app feedback (app/api/feedback) gets emailed. Without it,
# feedback is still saved to Firestore, just not emailed to anyone.
FEEDBACK_NOTIFY_EMAIL=

# App
# Stays as your local/Vercel preview URL until a custom domain is purchased.
# Set this to https://breezify.app once the domain is live — every deployed
# app's tracking beacon and /limit-reached redirect (see
# lib/analytics-snippet.ts) point here, so a stale value here means visitors
# on a real breezify.app deploy get bounced to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monitoring (all optional; the app runs fine with none of these set).
# Sentry error tracking. Create a project at sentry.io and paste its DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Secret the cron cleanup endpoint checks for before running
# (app/api/cron/cleanup). Generate a random string and configure the same
# value as a Bearer token on whatever schedules that endpoint (e.g. Vercel
# Cron's Authorization header).
CRON_SECRET=

# Templates section (see components/templates-section.tsx and
# app/api/admin/seed-templates). Both optional and unrelated to any
# user-facing feature working — without them, the Templates section still
# renders (its cards just prefill the composer instead of duplicating a
# real app, same as before this feature existed).
#
# The account that owns every seed app the Templates section duplicates
# from. Create a real Breezify account for this (any normal signup works)
# and paste its Firebase Auth uid here before running the seed endpoint.
TEMPLATE_ACCOUNT_UID=
# Bearer secret the one-time (safely re-runnable) seed endpoint checks
# before generating the actual template apps — see the curl example in
# app/api/admin/seed-templates/route.ts. Generate a random string; nothing
# else schedules or calls this automatically.
ADMIN_SEED_SECRET=

# SEO
# Google Search Console site verification. In Search Console, add the
# property, choose the "HTML tag" verification method, and copy just the
# `content="..."` value from the meta tag it gives you (not the whole tag)
# into this var. Leave blank until you're ready to verify; without it the
# meta tag simply isn't rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
