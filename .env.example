# Firebase (client config, not secret, safe to expose). These already have
# working defaults for Feather 123's own Firebase project baked into
# lib/firebase-public-config.ts, so you only need to set these if you're
# pointing this app at your own Firebase project instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Anthropic (Claude). This one is a real secret, required.
ANTHROPIC_API_KEY=

# Google Gemini. Optional: without it the Gemini models show as
# unavailable and the Anthropic ones still work.
GEMINI_API_KEY=

# Vercel (programmatic deploys of generated apps, not needed yet)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Stripe (not needed yet)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
# Stays as your local/Vercel preview URL until a custom domain is purchased.
NEXT_PUBLIC_APP_URL=http://localhost:3000
